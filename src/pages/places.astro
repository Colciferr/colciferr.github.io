---
// Favourite places, grouped by station. The list lives in src/data/places.ts.
import Site from '../layouts/Site.astro';
import { mapLink } from '../lib/which-map';
import { places } from '../data/places';

const stations = [...new Set(places.flatMap((p) => p.stations))].map((station) => ({
  station,
  places: places.filter((p) => p.stations.includes(station)),
}));
---

<Site title="Places" description="Favourite places to eat, drink and look around, filed by station.">
  {places.length === 0 && <p>Nothing here yet.</p>}
  {
    stations.map(({ station, places }) => (
      <section class="station">
        <h2>
          <a href={mapLink(station)}>{station}</a>
        </h2>
        <ul class="rows">
          {places.map((place) => (
            <li>
              <div class:list={['row', { pictured: place.photo }]}>
                {place.photo && <img src={place.photo.src} alt={place.photo.alt} loading="lazy" />}
                <span class="label">{place.kind}</span>
                <span class="row-title">
                  {place.link ? <a href={place.link}>{place.name}</a> : place.name}
                  {place.ja && (
                    <span class="ja" lang="ja">
                      {place.ja}
                    </span>
                  )}
                </span>
                {place.note && <span class="row-note">{place.note}</span>}
                {place.photo?.credit && (
                  <span class="row-note credit">
                    Photo: {place.photo.source ? <a href={place.photo.source}>{place.photo.credit}</a> : place.photo.credit}
                  </span>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Site>

<style>
  .station {
    margin-bottom: 2.5rem;
  }

  h2 {
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2.1rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin-bottom: 0.8rem;
  }

  h2 a {
    text-decoration: none;
  }

  h2 a::after {
    content: ' →';
    color: var(--mine);
  }

  /* A place with a picture: the picture down the left, the words beside it. */
  .pictured {
    grid-template-columns: 9rem 1fr;
    align-items: start;
  }

  .pictured img {
    grid-row: 1 / span 4;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 5px;
  }

  .pictured > :not(img) {
    grid-column: 2;
  }

  .credit {
    font-size: 0.72rem;
  }

  @media (max-width: 540px) {
    .pictured {
      grid-template-columns: 1fr;
    }

    .pictured img {
      grid-row: auto;
    }

    .pictured > :not(img) {
      grid-column: 1;
    }
  }

  .ja {
    margin-left: 0.6em;
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--muted);
  }
</style>
