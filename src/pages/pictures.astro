---
// Every photograph, grouped by the station it was taken near.
// The list is built by `npm run pictures` (see scripts/build-pictures.mjs).
import Site from '../layouts/Site.astro';
import { mapLink } from '../lib/which-map';
import pictures from '../data/pictures.json';

interface Photo {
  station: string;
  place: string;
  src: string;
  thumb: string;
  w: number;
  h: number;
  date?: string;
}

const photos = (pictures as { photos: Photo[] }).photos;
const stations = [...new Set(photos.map((p) => p.station))].map((station) => {
  const here = photos.filter((p) => p.station === station);
  return {
    station,
    places: [...new Set(here.map((p) => p.place))].map((place) => {
      const shots = here.filter((p) => p.place === place);
      return { place, date: shots.find((p) => p.date)?.date, shots };
    }),
  };
});
---

<Site title="Pictures" description="Photographs, filed by the station they were taken near.">
  {photos.length === 0 && <p>Nothing here yet.</p>}
  {
    stations.map(({ station, places }) => (
      <section class="station" id={station}>
        <h2>
          <a href={mapLink(station)}>{station}</a>
        </h2>
        {places.map(({ place, date, shots }) => (
          <div class="outing">
            <p class="label">
              {place}
              {date && ` · ${date}`}
            </p>
            <div class="grid">
              {shots.map((p) => (
                <a href={p.src} data-caption={[station, place === station ? '' : place, p.date].filter(Boolean).join(' · ')} style={`--ratio:${(p.w / p.h).toFixed(3)}`}>
                  <img src={p.thumb} alt={place} width={p.w} height={p.h} loading="lazy" />
                </a>
              ))}
            </div>
          </div>
        ))}
      </section>
    ))
  }

  <!-- A photograph opened large, with arrows to the ones before and after. -->
  <dialog class="lightbox" id="lightbox" aria-label="Photograph">
    <img id="lightbox-img" alt="" />
    <p id="lightbox-caption"></p>
    <button type="button" class="lb-prev" id="lightbox-prev" aria-label="Previous photograph">‹</button>
    <button type="button" class="lb-next" id="lightbox-next" aria-label="Next photograph">›</button>
    <button type="button" class="lb-close" id="lightbox-close" aria-label="Close">×</button>
  </dialog>
</Site>

<script>
  // Clicking a photograph opens it over the page. The arrows (on screen or
  // on the keyboard) step through every photograph on the page, in order.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.grid a'));
  const lightbox = document.getElementById('lightbox') as HTMLDialogElement;
  const image = document.getElementById('lightbox-img') as HTMLImageElement;
  const caption = document.getElementById('lightbox-caption')!;
  let current = 0;

  function show(index: number) {
    if (!links.length) return;
    current = (index + links.length) % links.length;
    const link = links[current];
    image.src = link.href;
    image.alt = link.querySelector('img')?.alt ?? '';
    caption.textContent = [link.dataset.caption, `${current + 1} of ${links.length}`].filter(Boolean).join(' · ');
    if (!lightbox.open) lightbox.showModal();
    // Fetch the neighbours now so the arrows feel instant.
    for (const step of [1, -1]) new Image().src = links[(current + step + links.length) % links.length].href;
  }

  links.forEach((link, index) =>
    link.addEventListener('click', (e) => {
      // Leave Ctrl-click, middle-click and the like to open the file as usual.
      if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey || e.button !== 0) return;
      e.preventDefault();
      show(index);
    }),
  );
  document.getElementById('lightbox-prev')!.addEventListener('click', () => show(current - 1));
  document.getElementById('lightbox-next')!.addEventListener('click', () => show(current + 1));
  document.getElementById('lightbox-close')!.addEventListener('click', () => lightbox.close());
  lightbox.addEventListener('click', (e) => e.target === lightbox && lightbox.close());
  lightbox.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
  // Put the page back where the last photograph viewed sits.
  lightbox.addEventListener('close', () => links[current]?.focus());
</script>

<style>
  .station {
    scroll-margin-top: 6rem;
    margin-bottom: 4rem;
  }

  h2 {
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2.1rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin-bottom: 0.3rem;
  }

  h2 a {
    text-decoration: none;
  }

  h2 a::after {
    content: ' →';
    color: var(--mine);
  }

  .outing {
    margin-top: 1.5rem;
  }

  .label {
    margin-bottom: 0.6rem;
  }

  /* Rows of equal height, each photo as wide as its shape needs. */
  .grid {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .grid a {
    flex: calc(var(--ratio) * 10) 1 calc(var(--ratio) * 8.5rem);
    max-width: calc(var(--ratio) * 12rem);
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: 4px;
    background: var(--rule);
  }

  .grid img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.15s;
  }

  .grid a:hover img,
  .grid a:focus-visible img {
    opacity: 0.85;
  }

  /* The large view. It matches the one on the map. */
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 2.5rem 3.5rem 3rem;
    border: 0;
    background: rgb(10 14 24 / 0.94);
    color: #fff;
  }

  .lightbox[open] {
    display: grid;
    grid-template-rows: 1fr auto;
    place-items: center;
    gap: 0.75rem;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox img {
    max-width: 100%;
    max-height: 100%;
    min-height: 0;
    object-fit: contain;
  }

  .lightbox p {
    font-size: 0.85rem;
    opacity: 0.8;
    text-align: center;
  }

  .lightbox button {
    position: absolute;
    background: none;
    border: 0;
    color: #fff;
    font-size: 2.4rem;
    line-height: 1;
    padding: 0.5rem 0.9rem;
    cursor: pointer;
    opacity: 0.75;
  }

  .lightbox button:hover {
    opacity: 1;
  }

  .lb-prev {
    left: 0;
    top: 50%;
    transform: translateY(-50%);
  }

  .lb-next {
    right: 0;
    top: 50%;
    transform: translateY(-50%);
  }

  .lb-close {
    top: 0;
    right: 0;
  }

  @media (max-width: 640px) {
    .lightbox {
      padding: 2.5rem 0.5rem 2.5rem;
    }
  }
</style>
