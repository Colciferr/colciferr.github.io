  h2,
  h3,
  p,
  ul,
  ol {
    margin: 0;
    padding: 0;
  }

  ul,
  ol {
    list-style: none;
  }

  button {
    font: inherit;
    color: inherit;
  }

  /* ---------------------------------------------------------------- Map */
  :root {
    --bar: 4.5rem;
  }

  .viewport {
    position: fixed;
    inset: var(--bar) 0 0 0;
    overflow: auto;
    cursor: grab;
