  }

  .viewport::-webkit-scrollbar {
    display: none;
  }

  .viewport.dragging {
    cursor: grabbing;
  }

  /* Empty space either side, as wide as the sign and the panel, so the ends
     of the map can be scrolled clear of them. */
  .world {
    /* When the whole map is smaller than the window, sit it in the middle. */
    display: grid;
    align-content: center;
    min-height: calc(100dvh - var(--bar));
