    stroke-width: calc(var(--lw) + 3px);
  }

  .line {
    stroke-width: var(--lw);
  }

  /* The Yamanote loop is the backbone, so it is drawn heavier. */
  .line.jr {
    stroke-width: calc(var(--lw) + 5px);
  }

  .casing.jr {
    stroke-width: calc(var(--lw) + 9px);
  }

  .line.excursion {
    stroke-width: 4px;
    stroke-dasharray: 2 9;
  }

  .casing.excursion {
    stroke-width: 0;
  }

  .dim {
    opacity: 0.12;
  }

  /* ---- The physical map: lines keep their thickness and markers their size
     on screen at any zoom, so the whole route to Kyoto stays readable. */
  #map.geo .line,
  #map.geo .casing {
    vector-effect: non-scaling-stroke;
  }

  #map.geo .mark {
    transform: scale(calc(1 / var(--z, 1)));
  }

  #map.geo .line.excursion {
    stroke-width: var(--lw);
    stroke-dasharray: none;
  }

  #map.far .station:not(.section):not(.shots) .mark,
